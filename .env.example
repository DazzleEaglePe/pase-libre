# Copia este archivo como `.env` en la raíz. Lo leen la API, Prisma y la web.
NODE_ENV=development

# API (NestJS)
PORT=3001
DATABASE_URL=postgresql://paselibre:paselibre_dev@localhost:5435/paselibre
# Base aparte para las pruebas e2e: se vacía en cada corrida.
TEST_DATABASE_URL=postgresql://paselibre:paselibre_dev@localhost:5435/paselibre_test
REDIS_URL=redis://localhost:6382
# Dirección pública de la web: la API la usa para el CORS y el enlace del mensaje de acceso, y la web para la vista al compartir (WhatsApp, redes).
WEB_URL=http://localhost:3000
LOG_LEVEL=debug
# En producción la cookie de sesión exige HTTPS. En local se apaga.
SESION_COOKIE_SEGURA=false
# En vivo: busco y ofertas flash (D-53). Encendido en local; en producción se enciende cuando se decida.
EN_VIVO=true
# Carpeta de las fotos subidas. Por defecto, apps/api/media; en producción, el volumen que sirve nginx.
# MEDIA_DIR=/var/lib/paselibre/media

# Web (Next.js): dónde llama el servidor de Next a la API.
API_INTERNAL_URL=http://localhost:3001
# Socket del chat. En local la web usa http://localhost:3001; en producción, el mismo dominio.
# NEXT_PUBLIC_TIEMPO_REAL_URL=

# Semilla de demostración: tiendas, cuentas y productos del lienzo.
# Nunca en producción.
SEMILLA_DEMO=true
# Clave de esas cuentas (por defecto, la de semilla.ts). En staging, una propia: el repositorio es público.
# CLAVE_DEMO=
