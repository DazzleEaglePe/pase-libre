# Copia este archivo fuera del repositorio (por ejemplo /opt/paselibre/config/staging.env o
# produccion.env), con permisos 600, y ajústalo al servidor. Lo leen compose.yml y los scripts de
# tools/deploy/scripts. Nunca se sube a git.

# ── Identidad del entorno ────────────────────────────────────────────────────
# `staging` o `produccion`. Va en el nombre del proyecto de compose y de los respaldos.
ENTORNO=staging
# Dirección pública con https y sin barra final. La API la usa para CORS y para el socket.
PUBLIC_URL=https://staging.paselibre.example
# Dirección donde la prueba de humo mira el sitio (por defecto, PUBLIC_URL).
# HUMO_URL=

# ── Imágenes ─────────────────────────────────────────────────────────────────
# Las escribe desplegar.sh en cada despliegue: la etiqueta en uso y la anterior (para revertir).
IMAGEN_TAG=
IMAGEN_TAG_ANTERIOR=

# ── Base de datos (Postgres 16 dentro de compose) ────────────────────────────
POSTGRES_USER=paselibre
# Valores seguros para una URL: `openssl rand -hex 24`.
POSTGRES_PASSWORD=CAMBIAR_POR_UN_VALOR_ALEATORIO
POSTGRES_DB=paselibre

# ── Fotos ────────────────────────────────────────────────────────────────────
# Carpeta del servidor con las fotos subidas. nginx la sirve en /media y el respaldo la copia.
# Debe existir y ser de uid 1000 (el usuario de la API):
#   install -d -o 1000 -g 1000 -m 755 /var/lib/paselibre/staging/media
MEDIA_DIR=/var/lib/paselibre/staging/media

# ── Puertos en el servidor (solo 127.0.0.1) ──────────────────────────────────
# Staging y producción en la misma máquina necesitan puertos distintos.
WEB_HOST_PORT=3100
API_HOST_PORT=3101

# ── Web ──────────────────────────────────────────────────────────────────────
# WhatsApp del equipo de PaseLibre, con código de país y sin signos (51999999999). Vacío = la web
# esconde el botón. Se fija al construir la imagen: cambiarlo obliga a volver a desplegar.
NEXT_PUBLIC_WHATSAPP_EQUIPO=

# ── Ajustes que casi nunca cambian ───────────────────────────────────────────
LOG_LEVEL=info
# Quién puede decirle a la API la IP real del cliente (X-Forwarded-For). Con nginx en el mismo
# servidor, `uniquelocal` alcanza; ver el comentario en compose.yml.
# PROXIES_DE_CONFIANZA=uniquelocal
# Memoria máxima de cada contenedor (un VPS de 4 GB aguanta staging y producción con esto).
# POSTGRES_MEMORIA=768m
# API_MEMORIA=512m
# WEB_MEMORIA=512m

# ── Despliegue ───────────────────────────────────────────────────────────────
# Archivo de entorno de los respaldos (respaldo.env). desplegar.sh respalda la base antes de
# migrar. Si ya hay una base y esto está vacío, el despliegue se detiene.
RESPALDO_ENV=/opt/paselibre/config/respaldo.env

# Solo para el staging con datos de demostración (semilla-demo.sh). Una clave larga y distinta
# de la del repositorio: el repositorio es público.
CLAVE_DEMO=
