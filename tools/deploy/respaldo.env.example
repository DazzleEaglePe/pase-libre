# Copia este archivo fuera del repositorio (por ejemplo /opt/paselibre/config/respaldo.env)
# y ajústalo al servidor. Lo leen respaldar.sh, restaurar.sh y ensayar-restauracion.sh.

# Ambiente: va en el nombre de cada respaldo (paselibre-produccion-20261031T080000Z.dump).
ENTORNO=produccion

# Compose donde corre Postgres y nombre del servicio.
COMPOSE_FILE=/opt/paselibre/app/tools/deploy/compose.yml
COMPOSE_SERVICIO=postgres

# Superusuario y base de la aplicación (los del contenedor de Postgres).
POSTGRES_USER=paselibre
POSTGRES_DB=paselibre

# Dónde quedan los respaldos en el servidor: diarios/ (7) y semanales/ (4).
RESPALDO_DIR=/var/backups/paselibre

# Carpeta de las fotos (el MEDIA_DIR de la API, el volumen que sirve nginx).
MEDIA_DIR=/var/lib/paselibre/media

# Copia fuera del servidor con rclone (docs/05 §10: B2). Vacío = sin copia externa,
# y el respaldo lo avisa. Ejemplo: b2:paselibre-respaldos
RCLONE_DESTINO=
