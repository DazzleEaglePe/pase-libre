// Esquema de la primera salida (docs/05-arquitectura.md §4).
// Las reglas que Prisma no expresa (los CHECK) están al final de la migración inicial.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto, pg_trgm, unaccent, fuzzystrmatch]
}

enum Rol {
  DUENO
  ASESOR
  EQUIPO

  @@map("rol")
}

enum EstadoUsuario {
  ACTIVO
  SUSPENDIDO

  @@map("estado_usuario")
}

enum TipoTienda {
  TIENDA
  INDEPENDIENTE

  @@map("tipo_tienda")
}

enum EstadoTienda {
  ACTIVA
  SUSPENDIDA

  @@map("estado_tienda")
}

enum Moneda {
  USD
  PEN

  @@map("moneda")
}

enum Condicion {
  NUEVO
  USADO

  @@map("condicion")
}

/// «Sin stock» no es un estado: sale de `stock = 0`.
enum EstadoOferta {
  ACTIVA
  PAUSADA
  ELIMINADA

  @@map("estado_oferta")
}

enum TipoMensaje {
  TEXTO
  FOTO
  SISTEMA
  /// «X te pidió tu WhatsApp» (N01): la otra tienda lo acepta o dice «Ahora no».
  PEDIDO_WHATSAPP
  /// «WhatsApp de X · +51 … · Abrir» (N01): el número de la tienda, compartido a propósito.
  WHATSAPP

  @@map("tipo_mensaje")
}

/// En qué quedó un pedido de WhatsApp (N01).
enum EstadoPedidoWhatsapp {
  PENDIENTE
  ACEPTADO
  RECHAZADO

  @@map("estado_pedido_whatsapp")
}

/// Por qué se guardó lo que decía un mensaje antes (N01): lo lee el Equipo, nunca el chat.
enum CambioMensaje {
  EDITADO
  ELIMINADO

  @@map("cambio_mensaje")
}

/// El papel de una respuesta rápida (N11): «Cuando te escriben» (vendes) o «Cuando tú
/// preguntas» (compras o buscas). En cada chat salen las del papel que se tiene ahí.
enum PapelRespuesta {
  VENDEDOR
  COMPRADOR

  @@map("papel_respuesta")
}

enum TipoAviso {
  MENSAJE
  SEGURIDAD
  RECORDATORIO
  SISTEMA
  /// Busco nuevo de un producto que la tienda tiene publicado (D-53).
  EN_VIVO
  /// Alguien respondió «¡Lo tengo!» o «¡Lo quiero!» a lo tuyo en vivo.
  EN_VIVO_RESPUESTA
  /// «¿Se vendió?» y ventas marcadas.
  VENTA
  /// Otra tienda te calificó.
  CALIFICACION
  /// Qué pasó con lo que reportaste.
  REPORTE
  /// Una tienda que sigues publicó algo nuevo.
  SEGUIDA
  /// Apareció algo que buscabas («Avísame cuando alguien la publique»).
  ALERTA
  /// Novedades del equipo PaseLibre.
  EQUIPO

  @@map("tipo_aviso")
}

enum ObjetoDenuncia {
  OFERTA
  CONVERSACION
  TIENDA
  EN_VIVO
  /// «Pedir revisión al Equipo» de una opinión (N03): la pide la tienda calificada.
  OPINION

  @@map("objeto_denuncia")
}

enum EstadoDenuncia {
  /// «Enviado»: todavía nadie del equipo lo abrió.
  ABIERTA
  /// «Lo revisa una persona».
  EN_REVISION
  /// «Resuelto»: el equipo hizo algo y lo cuenta en `resolucion`.
  REVISADA
  /// «Resuelto» sin acción: no se encontró nada.
  DESCARTADA

  @@map("estado_denuncia")
}

/// En vivo (D-53): lo que una tienda necesita hoy o lo que remata hoy.
enum TipoEnVivo {
  BUSCO
  FLASH

  @@map("tipo_en_vivo")
}

/// «Venció» no es un estado: es VIVO con `vence_en` ya pasado.
enum EstadoEnVivo {
  VIVO
  /// «Ya lo conseguí» en un busco.
  CONSEGUIDO
  /// La oferta flash se quedó sin unidades con «Vendido».
  VENDIDO
  /// «Cerrar oferta».
  CERRADO

  @@map("estado_en_vivo")
}

enum CanalContacto {
  CHAT
  WHATSAPP

  @@map("canal_contacto")
}

enum EstadoCarga {
  BORRADOR
  CARGADA
  DESCARTADA

  @@map("estado_carga")
}

/// Lo que el dueño le deja hacer a cada asesor (N12). Chatear y responder no está aquí: siempre se
/// puede. Agregar asesores y la seguridad de la tienda son solo del dueño.
enum PermisoAsesor {
  /// Comprar y vender a nombre de la tienda: contactar una publicación y responder en vivo.
  COMPRAR_VENDER
  MARCAR_VENDIDO
  /// Publicar en vivo (busco y oferta flash).
  EN_VIVO
  /// Publicar productos y cambiar precios.
  PUBLICAR
  /// Cambiar logo, banner o datos de la tienda.
  DATOS_TIENDA
  /// Ver el historial de ventas.
  HISTORIAL

  @@map("permiso_asesor")
}

// ── Cuentas ────────────────────────────────────────────────────────────────

/// La galería es un dato, no una constante (RNF-29).
model Galeria {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre   String   @unique @db.VarChar(80)
  slug     String   @unique @db.Citext
  activa   Boolean  @default(true)
  orden    Int      @default(0) @db.SmallInt
  /// Dónde queda en la avenida, en metros desde una esquina (CAT_Web3): con eso sale «a 3 min
  /// caminando». Lo pone el equipo; sin él no se dice la distancia.
  metros   Int?
  creadaEn DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)

  tiendas      Tienda[]
  enVivo       EnVivo[]
  /// Los cambios de lugar pedidos hacia esta galería (N09).
  cambiosLugar CambioLugar[]

  @@map("galeria")
}

/// Quien vende: una tienda de galería o un independiente (sin galería).
model Tienda {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo                 TipoTienda
  nombre               String        @db.VarChar(120)
  galeriaId            String?       @map("galeria_id") @db.Uuid
  stand                String?       @db.VarChar(20)
  /// «Sótano», «1», «2»… Lo trae el registro propio; el equipo lo completa en las demás.
  piso                 String?       @db.VarChar(20)
  whatsapp             String        @db.VarChar(20)
  horario              String?       @db.VarChar(120)
  /// El horario por días (N09): `[{ dias: ['lun', …], desde: '10:00', hasta: '19:00' }]`. Con él,
  /// `horario` se escribe solo («Lunes a sábado, 10:00 a 19:00 · Domingo cerrado»).
  horarioDatos         Json?         @map("horario_datos")
  /// Galería, piso o stand nuevos que esperan al Equipo (N09: «Pendiente de aprobación»).
  cambiosLugar         CambioLugar[]
  /// «Cómo llegar» (PCH_WebLlegar): «Subes por la escalera central y es el segundo pasillo…».
  indicaciones         String?       @db.VarChar(240)
  descripcion          String?       @db.VarChar(500)
  logo                 String?       @db.VarChar(300)
  /// La portada del perfil (COR1): una foto subida con `POST /v1/archivos`. Sin ella, la
  /// automática. `portada_posicion` es qué parte se ve de arriba (0) a abajo (100): «Acomodar».
  portadaRuta          String?       @map("portada_ruta") @db.VarChar(300)
  portadaAncho         Int?          @map("portada_ancho")
  portadaAlto          Int?          @map("portada_alto")
  portadaPosicion      Int           @default(50) @map("portada_posicion") @db.SmallInt
  /// Valores por defecto al publicar (D-37): precio oculto y en dólares.
  precioVisibleDefecto Boolean       @default(false) @map("precio_visible_defecto")
  /// Soles por defecto (guía del lienzo final); la tienda lo cambia en Configuración.
  monedaDefecto        Moneda        @default(PEN) @map("moneda_defecto")
  /// Cuándo su inicio llegó a 12 publicaciones de otras tiendas (N16): desde ahí es el inicio
  /// normal y ya no vuelve atrás, aunque después haya menos.
  inicioNormalEn       DateTime?     @map("inicio_normal_en") @db.Timestamptz(6)
  /// Fase 2 (RF-41). Se crea ahora para no migrar después.
  perfilPrivado        Boolean       @default(false) @map("perfil_privado")
  estado               EstadoTienda  @default(ACTIVA)
  /// Máximo de sesiones abiertas de la cuenta principal (N10). El equipo lo sube a pedido.
  limiteDispositivos   Int           @default(2) @map("limite_dispositivos") @db.SmallInt
  creadaEn             DateTime      @default(now()) @map("creada_en") @db.Timestamptz(6)
  actualizadaEn        DateTime      @default(now()) @updatedAt @map("actualizada_en") @db.Timestamptz(6)

  galeria              Galeria?          @relation(fields: [galeriaId], references: [id])
  usuarios             Usuario[]
  ofertas              Oferta[]
  productosCreados     Producto[]        @relation("ProductoCreadoPor")
  conversacionesCompra Conversacion[]    @relation("TiendaCompradora")
  conversacionesVenta  Conversacion[]    @relation("TiendaVendedora")
  bloqueos             Bloqueo[]
  comprasRegistradas   Venta[]           @relation("VentaTiendaCompradora")
  cargas               CargaPlanilla[]
  archivos             Archivo[]
  enVivo               EnVivo[]
  respuestasEnVivo     EnVivoRespuesta[]
  /// Las tiendas que esta sigue (SG_Web).
  siguiendo            Seguimiento[]     @relation("TiendaQueSigue")
  /// Las tiendas que la siguen.
  seguidores           Seguimiento[]     @relation("TiendaSeguida")
  opinionesRecibidas   Opinion[]         @relation("OpinionSobre")
  opinionesEscritas    Opinion[]         @relation("OpinionDe")
  denunciasRecibidas   Denuncia[]        @relation("DenunciaContra")
  /// «Descuento por defecto» para socios (PS_SociosWeb), por moneda, en céntimos.
  descuentoSocioPen    BigInt?           @map("descuento_socio_pen")
  descuentoSocioUsd    BigInt?           @map("descuento_socio_usd")
  /// Las tiendas que esta tiene como socias.
  socios               Socio[]           @relation("SociosDe")
  /// Las tiendas que tienen a esta como socia.
  socioDe              Socio[]           @relation("SocioDe")
  vistasDeOfertas      VistaOferta[]
  hiloEquipo           HiloEquipo?

  advertencias Advertencia[]
  destacados   Destacado[]

  registrosEquipo RegistroEquipo[]
  modosSoporte    ModoSoporte[]

  @@index([galeriaId])
  @@map("tienda")
}

model Usuario {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nula solo para el equipo de PaseLibre (CHECK en la migración).
  tiendaId          String?         @map("tienda_id") @db.Uuid
  rol               Rol
  usuario           String          @unique @db.Citext
  correo            String?         @unique @db.Citext
  nombre            String          @db.VarChar(120)
  whatsapp          String?         @db.VarChar(20)
  claveHash         String          @map("clave_hash") @db.VarChar(255)
  /// La clave que entrega el equipo es temporal: el primer ingreso obliga a cambiarla.
  debeCambiarClave  Boolean         @default(true) @map("debe_cambiar_clave")
  /// El panel del equipo en oscuro (COR18): se guarda en la cuenta.
  temaOscuro        Boolean         @default(false) @map("tema_oscuro")
  primerIngresoEn   DateTime?       @map("primer_ingreso_en") @db.Timestamptz(6)
  estado            EstadoUsuario   @default(ACTIVO)
  intentosFallidos  Int             @default(0) @map("intentos_fallidos") @db.SmallInt
  intentosDesde     DateTime?       @map("intentos_desde") @db.Timestamptz(6)
  bloqueadoHasta    DateTime?       @map("bloqueado_hasta") @db.Timestamptz(6)
  ultimoIngresoEn   DateTime?       @map("ultimo_ingreso_en") @db.Timestamptz(6)
  /// Cuándo vio (o saltó) las pantallas de bienvenida del primer ingreso (OB_WebB).
  bienvenidaVistaEn DateTime?       @map("bienvenida_vista_en") @db.Timestamptz(6)
  /// «¿Quieres seguir a…?» sale solo la primera vez que sigue a una tienda (SG_WebConfirmar).
  seguirExplicadoEn DateTime?       @map("seguir_explicado_en") @db.Timestamptz(6)
  /// Tocó la X de «¿Conoces una tienda que debería estar aquí?» (N07): el banner del inicio no
  /// vuelve a salir en ningún dispositivo.
  invitarCerradoEn  DateTime?       @map("invitar_cerrado_en") @db.Timestamptz(6)
  /// La última vez que entró a «Recién llegados» (N07): el «+N nuevo» cuenta desde ahí.
  recienVistoEn     DateTime?       @map("recien_visto_en") @db.Timestamptz(6)
  /// Última vez que tuvo el chat abierto (se conectó o se desconectó del tiempo real), para
  /// «Activo hace 2 h» (RF-47).
  ultimaConexionEn  DateTime?       @map("ultima_conexion_en") @db.Timestamptz(6)
  /// «No molestar» (RF-59), en minutos desde la medianoche, hora de Lima.
  noMolestarDesde   Int?            @map("no_molestar_desde") @db.SmallInt
  noMolestarHasta   Int?            @map("no_molestar_hasta") @db.SmallInt
  /// El «Visto» se puede desactivar (RF-57).
  mostrarVisto      Boolean         @default(true) @map("mostrar_visto")
  /// Solo cuentan para el asesor (N12): el dueño puede todo.
  permisos          PermisoAsesor[] @default([COMPRAR_VENDER, MARCAR_VENDIDO, EN_VIVO])
  /// «Pausado» por el dueño: no entra hasta que lo vuelva a activar.
  pausadoEn         DateTime?       @map("pausado_en") @db.Timestamptz(6)
  /// El dueño lo quitó: ya no sale en su lista ni entra (lo suyo pasó al dueño).
  quitadoEn         DateTime?       @map("quitado_en") @db.Timestamptz(6)
  creadoEn          DateTime        @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn     DateTime        @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  tienda               Tienda?            @relation(fields: [tiendaId], references: [id])
  sesiones             Sesion[]
  ofertasResponsable   Oferta[]
  conversacionesCompra Conversacion[]     @relation("Comprador")
  conversacionesVenta  Conversacion[]     @relation("Vendedor")
  participaciones      Participacion[]
  mensajes             Mensaje[]
  respuestasRapidas    RespuestaRapida[]
  bloqueos             Bloqueo[]
  denuncias            Denuncia[]
  ventasRegistradas    Venta[]            @relation("VentaRegistradaPor")
  compras              Venta[]            @relation("VentaComprador")
  avisos               Aviso[]
  preferenciasAviso    PreferenciaAviso[]
  seguimientos         Seguimiento[]
  opiniones            Opinion[]
  alertas              AlertaBusqueda[]
  busquedas            Busqueda[]
  contactos            Contacto[]
  cargas               CargaPlanilla[]
  auditorias           Auditoria[]
  archivos             Archivo[]
  enVivo               EnVivo[]
  respuestasEnVivo     EnVivoRespuesta[]

  mensajesEquipo MensajeEquipo[] @relation("MensajesEquipo")

  advertenciasDadas Advertencia[]         @relation("AdvertenciasDadas")
  comunicados       Comunicado[]          @relation("ComunicadosEnviados")
  registrosEquipo   RegistroEquipo[]      @relation("RegistrosEquipo")
  destacados        Destacado[]           @relation("DestacadosPor")
  importaciones     ImportacionCatalogo[]

  soportesDados   ModoSoporte[] @relation("SoporteDelEquipo")
  soportesPedidos ModoSoporte[] @relation("SoportePedidoPor")

  @@index([tiendaId])
  @@map("usuario")
}

/// Token opaco en una cookie httpOnly; aquí solo se guarda su hash (A-05).
model Sesion {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  recordar   Boolean   @default(false)
  creadaEn   DateTime  @default(now()) @map("creada_en") @db.Timestamptz(6)
  usadaEn    DateTime  @default(now()) @map("usada_en") @db.Timestamptz(6)
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz(6)
  revocadaEn DateTime? @map("revocada_en") @db.Timestamptz(6)
  agente     String?   @db.VarChar(300)
  ip         String?   @db.VarChar(45)
  /// La sesión de alguien del equipo en «Ayudar como la tienda» (N14): mientras dure, ve
  /// PaseLibre como el dueño de esa tienda.
  soporteId  String?   @map("soporte_id") @db.Uuid

  usuario Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  soporte ModoSoporte? @relation(fields: [soporteId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@map("sesion")
}

// ── Catálogo: producto y oferta (D-43) ─────────────────────────────────────

model Categoria {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre  String  @db.VarChar(80)
  slug    String  @unique @db.Citext
  orden   Int     @default(0) @db.SmallInt
  /// El grupo del menú «Todas las categorías» (Componentes, Equipos, Periféricos…).
  grupo   String? @db.VarChar(40)
  padreId String? @map("padre_id") @db.Uuid

  padre     Categoria?  @relation("Subcategorias", fields: [padreId], references: [id])
  hijas     Categoria[] @relation("Subcategorias")
  productos Producto[]
  enVivo    EnVivo[]

  @@map("categoria")
}

model Marca {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre String @unique @db.Citext
  slug   String @unique @db.Citext

  productos Producto[]

  @@map("marca")
}

/// El modelo que existe en el mercado, una sola vez en el catálogo.
model Producto {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoriaId       String   @map("categoria_id") @db.Uuid
  marcaId           String?  @map("marca_id") @db.Uuid
  titulo            String   @db.VarChar(200)
  modelo            String?  @db.VarChar(120)
  /// «OC», «Normal», «Ti»… (COR9 y COR15): va también en el título.
  version           String?  @db.VarChar(40)
  /// El código del fabricante (TUF-RTX5070-O12G-GAMING). Nunca se unen productos con códigos
  /// distintos (COR15); dos productos no comparten código.
  codigoParte       String?  @unique @map("codigo_parte") @db.Citext
  slug              String   @unique @db.Citext
  caracteristicas   Json     @default("{}")
  /// Título, marca, modelo y etiquetas pasados por `normalizarTexto` (índice trigram).
  textoBusqueda     String   @default("") @map("texto_busqueda")
  /// Lo creó un vendedor y el equipo aún no revisó si está repetido.
  revisado          Boolean  @default(false)
  creadoPorTiendaId String?  @map("creado_por_tienda_id") @db.Uuid
  /// Si se unió a otro producto (RF-54), su dirección redirige allí.
  fusionadoEnId     String?  @map("fusionado_en_id") @db.Uuid
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn     DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  categoria       Categoria          @relation(fields: [categoriaId], references: [id])
  marca           Marca?             @relation(fields: [marcaId], references: [id])
  creadoPorTienda Tienda?            @relation("ProductoCreadoPor", fields: [creadoPorTiendaId], references: [id])
  fusionadoEn     Producto?          @relation("Fusiones", fields: [fusionadoEnId], references: [id])
  fusionados      Producto[]         @relation("Fusiones")
  fotos           ProductoFoto[]
  etiquetas       ProductoEtiqueta[]
  ofertas         Oferta[]
  enVivo          EnVivo[]

  preciosDiarios PrecioDiario[]

  @@index([categoriaId])
  @@index([marcaId])
  @@index([textoBusqueda(ops: raw("gin_trgm_ops"))], type: Gin, map: "producto_texto_busqueda_trgm_idx")
  @@map("producto")
}

model ProductoFoto {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productoId String @map("producto_id") @db.Uuid
  ruta       String @db.VarChar(300)
  orden      Int    @default(0) @db.SmallInt
  ancho      Int?
  alto       Int?

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
  @@map("producto_foto")
}

model Etiqueta {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre String @db.VarChar(60)
  /// «RTX3070», «rtx 3070» y «RTX-3070» comparten la clave «rtx 3070» (RNF-26).
  clave  String @unique @db.Citext

  productos ProductoEtiqueta[]

  @@map("etiqueta")
}

model ProductoEtiqueta {
  productoId String @map("producto_id") @db.Uuid
  etiquetaId String @map("etiqueta_id") @db.Uuid

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([productoId, etiquetaId])
  @@index([etiquetaId])
  @@map("producto_etiqueta")
}

/// Lo que una tienda tiene de un producto. Única por producto, tienda y condición
/// mientras no esté eliminada (ver `vigente`).
model Oferta {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productoId              String         @map("producto_id") @db.Uuid
  tiendaId                String         @map("tienda_id") @db.Uuid
  /// Quien recibe los mensajes de esta oferta (A-11): por defecto, quien la publicó.
  responsableId           String         @map("responsable_id") @db.Uuid
  condicion               Condicion
  stock                   Int            @default(1)
  /// Céntimos enteros: US$ 250 → 25000. Nulo = sin precio cargado («Al interno»).
  precioCentimos          BigInt?        @map("precio_centimos")
  moneda                  Moneda         @default(USD)
  precioVisible           Boolean        @default(false) @map("precio_visible")
  /// «Mostrar el nombre de mi tienda». Apagado, las demás tiendas ven «Tienda reservada»: sin
  /// nombre, stand ni WhatsApp, y se escribe solo por chat. La dueña y el equipo la ven igual.
  tiendaVisible           Boolean        @default(true) @map("tienda_visible")
  descripcion             String?        @db.VarChar(500)
  /// La foto de portada que eligió la tienda (docs/17 §5): la ruta de una de sus `fotos`. Nula =
  /// la de siempre: la primera del producto o, si no tiene, la primera de la tienda.
  portadaRuta             String?        @map("portada_ruta") @db.VarChar(300)
  /// «Nuevo sellado», «Open box», «Usado» o «Reacondicionado» (PUB_WebProducto). `condicion`
  /// sigue siendo nuevo o usado, para los filtros.
  estadoDetalle           EstadoDetalle? @map("estado_detalle")
  /// Lo que escribió quien publica al elegir «Otro» en el estado (COR9).
  estadoOtro              String?        @map("estado_otro") @db.VarChar(40)
  conCaja                 Boolean        @default(false) @map("con_caja")
  conFactura              Boolean        @default(false) @map("con_factura")
  probado                 Boolean        @default(false)
  garantia                Garantia?
  /// La garantía escrita a mano con «Otro» (COR9): «2 años», «15 días».
  garantiaOtra            String?        @map("garantia_otra") @db.VarChar(40)
  /// «En almacén · ~30 min»: no está en el stand.
  enAlmacen               Boolean        @default(false) @map("en_almacen")
  /// «¿Cómo lo vendes?»: pase (sin comprobante), facturado (con IGV) o los dos.
  modoVenta               ModoVenta      @default(PASE) @map("modo_venta")
  /// El precio con factura e IGV, en céntimos (PS_Precio).
  precioFacturadoCentimos BigInt?        @map("precio_facturado_centimos")
  /// «Precio socio»: cuánto menos ven tus socios, en céntimos.
  descuentoSocioCentimos  BigInt?        @map("descuento_socio_centimos")
  /// «¿Quién ve el precio?» = «Solo mis socios»: el precio está oculto (`precioVisible` en falso)
  /// salvo para las tiendas que la tienda tiene como socias.
  soloSocios              Boolean        @default(false) @map("solo_socios")
  /// «Acepto ofertas en el chat».
  aceptaOfertas           Boolean        @default(true) @map("acepta_ofertas")
  /// «Precio fijo ▾ / Negociable» del campo de precio (N06): la burbujita «Negociable».
  negociable              Boolean        @default(false)
  estado                  EstadoOferta   @default(ACTIVA)
  /// El precio de pase antes de la última baja y cuándo bajó: «Bajó de precio · Antes US$ 465»
  /// (SEG_Web). Una subida lo borra.
  precioAnteriorCentimos  BigInt?        @map("precio_anterior_centimos")
  precioBajoEn            DateTime?      @map("precio_bajo_en") @db.Timestamptz(6)
  /// «¿Por qué la pausas?» (MP_Web): se ve en la pestaña «Pausadas». Nulo si está activa.
  razonPausa              String?        @map("razon_pausa") @db.VarChar(60)
  /// `true` mientras no esté eliminada y nulo al eliminarla. Con él, el índice único
  /// deja una sola oferta vigente por producto, tienda y condición sin índice parcial,
  /// que Prisma no sabe mantener. Un CHECK lo ata a `estado`.
  vigente                 Boolean?       @default(true)
  /// Cambia con stock, precio, visibilidad o «Siguen igual» (RF-09, RF-10).
  actualizadaEn           DateTime       @default(now()) @map("actualizada_en") @db.Timestamptz(6)
  creadaEn                DateTime       @default(now()) @map("creada_en") @db.Timestamptz(6)

  producto         Producto          @relation(fields: [productoId], references: [id])
  tienda           Tienda            @relation(fields: [tiendaId], references: [id])
  responsable      Usuario           @relation(fields: [responsableId], references: [id])
  fotos            OfertaFoto[]
  conversaciones   Conversacion[]
  ventas           Venta[]
  contactos        Contacto[]
  enVivo           EnVivo[]
  respuestasEnVivo EnVivoRespuesta[]
  vistas           VistaOferta[]

  @@unique([productoId, tiendaId, condicion, vigente], map: "oferta_vigente_key")
  @@index([productoId, estado])
  @@index([tiendaId, estado])
  @@index([responsableId])
  /// «Recién publicado» de la portada.
  @@index([estado, actualizadaEn])
  @@map("oferta")
}

model OfertaFoto {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ofertaId String @map("oferta_id") @db.Uuid
  ruta     String @db.VarChar(300)
  orden    Int    @default(0) @db.SmallInt
  ancho    Int?
  alto     Int?

  oferta Oferta @relation(fields: [ofertaId], references: [id], onDelete: Cascade)

  @@index([ofertaId])
  @@map("oferta_foto")
}

/// Palabras conocidas del catálogo, para corregir «3370» → «3070» (docs/05 §7).
model Termino {
  /// Ya normalizada con `normalizarTexto`.
  palabra String @id
  veces   Int    @default(1)

  @@index([palabra(ops: raw("gin_trgm_ops"))], type: Gin, map: "termino_palabra_trgm_idx")
  @@map("termino")
}

// ── Mensajes y avisos (bandeja por persona, A-11) ──────────────────────────

model Conversacion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ofertaId           String   @map("oferta_id") @db.Uuid
  compradorId        String   @map("comprador_id") @db.Uuid
  vendedorId         String   @map("vendedor_id") @db.Uuid
  tiendaCompradoraId String   @map("tienda_compradora_id") @db.Uuid
  tiendaVendedoraId  String   @map("tienda_vendedora_id") @db.Uuid
  ultimoMensajeEn    DateTime @default(now()) @map("ultimo_mensaje_en") @db.Timestamptz(6)
  creadaEn           DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)
  /// La tarjeta en vivo que el chat muestra arriba (D-53): el hilo nació de un «¡Lo tengo!»
  /// o un «¡Lo quiero!».
  enVivoId           String?  @map("en_vivo_id") @db.Uuid

  oferta           Oferta            @relation(fields: [ofertaId], references: [id])
  comprador        Usuario           @relation("Comprador", fields: [compradorId], references: [id])
  vendedor         Usuario           @relation("Vendedor", fields: [vendedorId], references: [id])
  tiendaCompradora Tienda            @relation("TiendaCompradora", fields: [tiendaCompradoraId], references: [id])
  tiendaVendedora  Tienda            @relation("TiendaVendedora", fields: [tiendaVendedoraId], references: [id])
  participaciones  Participacion[]
  mensajes         Mensaje[]
  ventas           Venta[]
  avisos           Aviso[]
  enVivo           EnVivo?           @relation(fields: [enVivoId], references: [id], onDelete: SetNull)
  respuestasEnVivo EnVivoRespuesta[]

  @@unique([ofertaId, compradorId])
  @@index([compradorId, ultimoMensajeEn])
  @@index([vendedorId, ultimoMensajeEn])
  /// «Responde en ~N min»: los hilos de una tienda que vende, de los últimos 60 días.
  @@index([tiendaVendedoraId, creadaEn])
  @@map("conversacion")
}

/// Estado de cada persona en el hilo: archivar, silenciar, no leída y «Visto».
model Participacion {
  conversacionId String    @map("conversacion_id") @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  archivada      Boolean   @default(false)
  silenciada     Boolean   @default(false)
  noLeidaManual  Boolean   @default(false) @map("no_leida_manual")
  leidoHasta     DateTime? @map("leido_hasta") @db.Timestamptz(6)
  /// Hasta cuándo le llegaron los mensajes (N01, dos checks grises): tenía el chat abierto en
  /// algún equipo cuando se enviaron, o se conectó después.
  recibidoHasta  DateTime? @map("recibido_hasta") @db.Timestamptz(6)

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([conversacionId, usuarioId])
  @@index([usuarioId])
  @@map("participacion")
}

model Mensaje {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversacionId String      @map("conversacion_id") @db.Uuid
  /// Nulo en los mensajes del sistema («Marcaste 1 unidad como vendida…»).
  autorId        String?     @map("autor_id") @db.Uuid
  tipo           TipoMensaje
  texto          String?     @db.VarChar(2000)
  foto           String?     @db.VarChar(300)
  creadoEn       DateTime    @default(now()) @map("creado_en") @db.Timestamptz(6)

  /// «editado ·» (N01): la última vez que su autor lo cambió, dentro de los 15 minutos.
  editadoEn    DateTime?             @map("editado_en") @db.Timestamptz(6)
  /// «Eliminar para todos» (N01): el texto y la foto se vacían; lo de antes queda en
  /// `mensaje_version` para el Equipo.
  eliminadoEn  DateTime?             @map("eliminado_en") @db.Timestamptz(6)
  /// «Eliminar para mí»: quienes ya no lo ven. Para el otro y para el Equipo sigue igual.
  ocultoPara   String[]              @default([]) @map("oculto_para") @db.Uuid
  /// «Responder»: el mensaje que cita.
  respondeAId  String?               @map("responde_a_id") @db.Uuid
  /// En qué quedó el pedido de WhatsApp. Solo en `PEDIDO_WHATSAPP`.
  pedidoEstado EstadoPedidoWhatsapp? @map("pedido_estado")
  /// El WhatsApp de la tienda tal como estaba al compartirlo. Solo en `WHATSAPP`.
  whatsapp     String?               @db.VarChar(20)

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  autor        Usuario?     @relation(fields: [autorId], references: [id])

  respondeA  Mensaje?         @relation("Respuestas", fields: [respondeAId], references: [id], onDelete: SetNull)
  respuestas Mensaje[]        @relation("Respuestas")
  versiones  MensajeVersion[]

  @@index([conversacionId, creadoEn])
  @@map("mensaje")
}

/// Lo que decía un mensaje antes de editarlo o de eliminarlo para todos (N01). El chat ya no lo
/// muestra; queda para que el Equipo lo lea en solo lectura (ficha de la tienda › Conversaciones).
model MensajeVersion {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mensajeId String        @map("mensaje_id") @db.Uuid
  cambio    CambioMensaje
  texto     String?       @db.VarChar(2000)
  foto      String?       @db.VarChar(300)
  creadaEn  DateTime      @default(now()) @map("creada_en") @db.Timestamptz(6)

  mensaje Mensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  @@index([mensajeId, creadaEn])
  @@map("mensaje_version")
}

model RespuestaRapida {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String @map("usuario_id") @db.Uuid
  /// Con `{tienda}` donde va el nombre de la otra tienda («Nombre de la tienda», N11).
  texto     String @db.VarChar(120)
  orden     Int    @default(0) @db.SmallInt

  papel PapelRespuesta @default(VENDEDOR)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("respuesta_rapida")
}

/// Quien bloquea, bloquea a la tienda entera (docs/05 §8).
model Bloqueo {
  /// Para deshacer un bloqueo hecho con la tienda reservada sin dar el id de la tienda.
  id                String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId         String   @map("usuario_id") @db.Uuid
  tiendaBloqueadaId String   @map("tienda_bloqueada_id") @db.Uuid
  /// Se bloqueó desde el chat de una oferta con la tienda reservada: la lista no la nombra.
  reservada         Boolean  @default(false)
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario         Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tiendaBloqueada Tienda  @relation(fields: [tiendaBloqueadaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, tiendaBloqueadaId])
  @@map("bloqueo")
}

/// Los tres motivos de «Reportar» (REP_Web). Las de estafa las ve primero el equipo.
enum MotivoDenuncia {
  ESTAFA
  DESCRITO
  TRATO

  @@map("motivo_denuncia")
}

model Denuncia {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// «R-1042»: el número que se le muestra a quien reportó.
  codigo                Int             @unique @default(autoincrement())
  denuncianteId         String          @map("denunciante_id") @db.Uuid
  objeto                ObjetoDenuncia
  objetoId              String          @map("objeto_id") @db.Uuid
  /// La tienda reportada, resuelta al crear (para la cola del equipo y «Mis reportes»).
  tiendaDenunciadaId    String?         @map("tienda_denunciada_id") @db.Uuid
  /// Nulo en las denuncias de antes del lienzo final, que solo tenían texto.
  tipo                  MotivoDenuncia?
  /// «Cuéntanos qué pasó» (opcional).
  motivo                String?         @db.VarChar(500)
  /// «Adjuntar este chat»: solo entonces el equipo puede leer esa conversación.
  conversacionAdjuntaId String?         @map("conversacion_adjunta_id") @db.Uuid
  /// Se reportó una publicación con la tienda reservada: «Mis reportes» no la nombra.
  reservada             Boolean         @default(false)
  estado                EstadoDenuncia  @default(ABIERTA)
  /// Lo que el equipo le cuenta a quien reportó («Le escribimos a…, corrigió el estado»).
  resolucion            String?         @db.VarChar(500)
  tomadaEn              DateTime?       @map("tomada_en") @db.Timestamptz(6)
  resueltaEn            DateTime?       @map("resuelta_en") @db.Timestamptz(6)
  creadaEn              DateTime        @default(now()) @map("creada_en") @db.Timestamptz(6)

  denunciante      Usuario @relation(fields: [denuncianteId], references: [id])
  tiendaDenunciada Tienda? @relation("DenunciaContra", fields: [tiendaDenunciadaId], references: [id])

  mensajesEquipo MensajeEquipo[]

  advertencias Advertencia[]

  @@index([estado, creadaEn])
  @@index([denuncianteId, creadaEn(sort: Desc)])
  @@map("denuncia")
}

/// Cada «Vendido» (RF-47), con el stock antes y después.
model Venta {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ofertaId           String    @map("oferta_id") @db.Uuid
  compradorId        String?   @map("comprador_id") @db.Uuid
  tiendaCompradoraId String?   @map("tienda_compradora_id") @db.Uuid
  conversacionId     String?   @map("conversacion_id") @db.Uuid
  stockAntes         Int       @map("stock_antes")
  stockDespues       Int       @map("stock_despues")
  registradaPorId    String    @map("registrada_por_id") @db.Uuid
  /// El precio de pase de la oferta cuando se vendió (HI_A2_Web). Nulo si no tenía monto.
  precioCentimos     BigInt?   @map("precio_centimos")
  moneda             Moneda?
  /// «Recordarle» que califique (una vez).
  recordadaEn        DateTime? @map("recordada_en") @db.Timestamptz(6)
  creadaEn           DateTime  @default(now()) @map("creada_en") @db.Timestamptz(6)

  oferta           Oferta        @relation(fields: [ofertaId], references: [id])
  comprador        Usuario?      @relation("VentaComprador", fields: [compradorId], references: [id])
  tiendaCompradora Tienda?       @relation("VentaTiendaCompradora", fields: [tiendaCompradoraId], references: [id])
  conversacion     Conversacion? @relation(fields: [conversacionId], references: [id])
  registradaPor    Usuario       @relation("VentaRegistradaPor", fields: [registradaPorId], references: [id])

  opiniones Opinion[]

  @@index([ofertaId])
  @@map("venta")
}

/// «¿De qué quieres que te avisemos?» al seguir a una tienda (SG_Web, opciones).
enum AvisosSeguimiento {
  /// Cada producto nuevo y cada pedido en vivo.
  TODO
  /// Productos nuevos y sus pedidos en vivo, máximo un aviso al día.
  IMPORTANTE
  /// Igual sus productos salen primero en el inicio.
  NINGUNO

  @@map("avisos_seguimiento")
}

/// Una tienda sigue a otra (SG_Web). Lo toca una persona, pero sigue la tienda entera.
model Seguimiento {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tiendaId  String            @map("tienda_id") @db.Uuid
  seguidaId String            @map("seguida_id") @db.Uuid
  usuarioId String            @map("usuario_id") @db.Uuid
  avisos    AvisosSeguimiento @default(IMPORTANTE)
  /// El último aviso que se mandó por esta tienda (para «máximo uno al día»).
  avisadoEn DateTime?         @map("avisado_en") @db.Timestamptz(6)
  creadoEn  DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)

  tienda  Tienda  @relation("TiendaQueSigue", fields: [tiendaId], references: [id], onDelete: Cascade)
  seguida Tienda  @relation("TiendaSeguida", fields: [seguidaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([tiendaId, seguidaId])
  @@index([seguidaId])
  @@map("seguimiento")
}

/// Quién escribe la opinión de una venta: la tienda que compró o la que vendió.
enum LadoOpinion {
  COMPRADOR
  VENDEDOR

  @@map("lado_opinion")
}

/// La opinión de una tienda sobre otra después de una venta marcada en el chat (PCH_CelCalificar).
/// Una por venta y por lado. Solo opina quien compró o vendió; la tienda opinada responde una vez.
model Opinion {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ventaId       String      @map("venta_id") @db.Uuid
  lado          LadoOpinion
  autorTiendaId String      @map("autor_tienda_id") @db.Uuid
  autorId       String      @map("autor_id") @db.Uuid
  /// La tienda sobre la que se opina.
  tiendaId      String      @map("tienda_id") @db.Uuid
  estrellas     Int         @db.SmallInt
  /// Lo que se marcó: «Producto como se describió», «Precio como se publicó»…
  aspectos      String[]    @db.VarChar(40)
  texto         String?     @db.VarChar(500)
  respuesta     String?     @db.VarChar(500)
  respondidaEn  DateTime?   @map("respondida_en") @db.Timestamptz(6)
  creadaEn      DateTime    @default(now()) @map("creada_en") @db.Timestamptz(6)

  venta       Venta   @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  autorTienda Tienda  @relation("OpinionDe", fields: [autorTiendaId], references: [id])
  autor       Usuario @relation(fields: [autorId], references: [id])
  tienda      Tienda  @relation("OpinionSobre", fields: [tiendaId], references: [id])

  @@unique([ventaId, lado])
  @@index([tiendaId, creadaEn(sort: Desc)])
  @@map("opinion")
}

/// Campanita (RF-40). Un aviso por conversación con mensajes sin leer: se actualiza, no se apila.
model Aviso {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  tipo           TipoAviso
  titulo         String    @db.VarChar(160)
  extracto       String?   @db.VarChar(240)
  enlace         String?   @db.VarChar(300)
  /// Lo que hace el botón del aviso (AV_Web): «Ver su oferta», «¡Lo tengo!»…
  accion         Json?
  conversacionId String?   @map("conversacion_id") @db.Uuid
  /// Con «No molestar», el aviso aparece al terminar el horario.
  visibleDesde   DateTime  @default(now()) @map("visible_desde") @db.Timestamptz(6)
  leidoEn        DateTime? @map("leido_en") @db.Timestamptz(6)
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn  DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conversacion Conversacion? @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, conversacionId])
  @@index([usuarioId, leidoEn, visibleDesde])
  @@index([usuarioId, actualizadoEn])
  @@map("aviso")
}

model PreferenciaAviso {
  usuarioId String    @map("usuario_id") @db.Uuid
  tipo      TipoAviso
  campanita Boolean   @default(true)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, tipo])
  @@map("preferencia_aviso")
}

// ── En vivo: busco y ofertas flash (D-53) ──────────────────────────────────

/// Un busco o una oferta flash. Dura unas horas; las reglas que Prisma no expresa son
/// CHECK de la migración `en_vivo`.
model EnVivo {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo           TipoEnVivo
  autorId        String       @map("autor_id") @db.Uuid
  tiendaId       String       @map("tienda_id") @db.Uuid
  /// La de la tienda al publicar, para filtrar sin mirar la tienda.
  galeriaId      String?      @map("galeria_id") @db.Uuid
  categoriaId    String       @map("categoria_id") @db.Uuid
  /// Obligatorio en la oferta flash; en el busco, nulo si se escribió como texto libre.
  productoId     String?      @map("producto_id") @db.Uuid
  /// La publicación que sale en oferta flash.
  ofertaId       String?      @map("oferta_id") @db.Uuid
  titulo         String       @db.VarChar(200)
  /// Las unidades que busca, o las que quedan en la oferta flash.
  cantidad       Int          @default(1) @db.SmallInt
  /// Las que ya se vendieron con «Vendido» (oferta flash).
  vendidas       Int          @default(0) @db.SmallInt
  /// Nula en el busco = «cualquiera».
  condicion      Condicion?
  /// El precio de pase en la oferta flash; el presupuesto (opcional) en el busco.
  precioCentimos BigInt?      @map("precio_centimos")
  moneda         Moneda       @default(USD)
  nota           String?      @db.VarChar(120)
  /// «Mostrarlo» (PUB_WebVivo): apagado, las tiendas ven «Presupuesto: consultar».
  mostrarPrecio  Boolean      @default(true) @map("mostrar_precio")
  /// A cuántas tiendas les llegó el aviso al publicar el busco.
  avisadas       Int          @default(0) @db.SmallInt
  venceEn        DateTime     @map("vence_en") @db.Timestamptz(6)
  estado         EstadoEnVivo @default(VIVO)
  cerradoEn      DateTime?    @map("cerrado_en") @db.Timestamptz(6)
  creadoEn       DateTime     @default(now()) @map("creado_en") @db.Timestamptz(6)

  autor          Usuario           @relation(fields: [autorId], references: [id])
  tienda         Tienda            @relation(fields: [tiendaId], references: [id])
  galeria        Galeria?          @relation(fields: [galeriaId], references: [id])
  categoria      Categoria         @relation(fields: [categoriaId], references: [id])
  producto       Producto?         @relation(fields: [productoId], references: [id])
  oferta         Oferta?           @relation(fields: [ofertaId], references: [id])
  respuestas     EnVivoRespuesta[]
  conversaciones Conversacion[]

  @@index([estado, venceEn])
  @@index([autorId, estado])
  /// «Cerrados hoy».
  @@index([cerradoEn])
  @@map("en_vivo")
}

/// Cada «¡Lo tengo!» o «¡Lo quiero!»: una por tienda en cada publicación en vivo.
model EnVivoRespuesta {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enVivoId       String   @map("en_vivo_id") @db.Uuid
  usuarioId      String   @map("usuario_id") @db.Uuid
  tiendaId       String   @map("tienda_id") @db.Uuid
  /// La publicación que ofrece quien responde a un busco.
  ofertaId       String?  @map("oferta_id") @db.Uuid
  conversacionId String   @map("conversacion_id") @db.Uuid
  creadaEn       DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)

  enVivo       EnVivo       @relation(fields: [enVivoId], references: [id], onDelete: Cascade)
  usuario      Usuario      @relation(fields: [usuarioId], references: [id])
  tienda       Tienda       @relation(fields: [tiendaId], references: [id])
  oferta       Oferta?      @relation(fields: [ofertaId], references: [id])
  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@unique([enVivoId, tiendaId])
  @@index([conversacionId])
  @@map("en_vivo_respuesta")
}

// ── Métricas y operación ───────────────────────────────────────────────────

/// Incluye las búsquedas sin resultados (RF-32).
model Busqueda {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  texto          String   @db.VarChar(200)
  textoCorregido String?  @map("texto_corregido") @db.VarChar(200)
  resultados     Int
  usuarioId      String?  @map("usuario_id") @db.Uuid
  creadaEn       DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([creadaEn])
  @@map("busqueda")
}

/// Clics en «Enviar mensaje» y «WhatsApp» (RF-23).
model Contacto {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ofertaId  String        @map("oferta_id") @db.Uuid
  usuarioId String        @map("usuario_id") @db.Uuid
  canal     CanalContacto
  creadoEn  DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)

  oferta  Oferta  @relation(fields: [ofertaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([ofertaId])
  @@index([creadoEn])
  @@map("contacto")
}

/// Carga por planilla (RF-34): vista previa antes de crear las ofertas.
model CargaPlanilla {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tiendaId    String      @map("tienda_id") @db.Uuid
  creadaPorId String      @map("creada_por_id") @db.Uuid
  archivo     String      @db.VarChar(200)
  filas       Json        @default("[]")
  estado      EstadoCarga @default(BORRADOR)
  creadaEn    DateTime    @default(now()) @map("creada_en") @db.Timestamptz(6)

  tienda    Tienda  @relation(fields: [tiendaId], references: [id])
  creadaPor Usuario @relation(fields: [creadaPorId], references: [id])

  @@map("carga_planilla")
}

/// Foto subida con `POST /archivos` (RNF-20): ya revisada, sin EXIF y en WebP. Queda
/// pendiente hasta que una oferta, un producto o un mensaje la usa; solo la puede usar
/// alguien de la misma tienda, y una sola vez.
model Archivo {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tiendaId  String?   @map("tienda_id") @db.Uuid
  ruta      String    @unique @db.VarChar(300)
  ancho     Int
  alto      Int
  bytes     Int
  usadoEn   DateTime? @map("usado_en") @db.Timestamptz(6)
  creadoEn  DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  tienda  Tienda? @relation(fields: [tiendaId], references: [id])

  @@index([usuarioId, creadoEn])
  @@index([tiendaId])
  @@map("archivo")
}

/// Acciones del equipo: crear cuenta, nueva clave, suspender, traspasar, unir productos.
model Auditoria {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId  String?  @map("actor_id") @db.Uuid
  accion   String   @db.VarChar(60)
  objeto   String   @db.VarChar(40)
  objetoId String?  @map("objeto_id") @db.Uuid
  datos    Json     @default("{}")
  creadaEn DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)

  actor Usuario? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([creadaEn])
  @@map("auditoria")
}

enum EstadoSolicitud {
  /// Espera a una persona del equipo (máx. 3 h para quien se registra sin RUC).
  PENDIENTE
  /// El equipo pidió corregir algo; quien se registra lo ve y reenvía.
  REQUIERE_CAMBIOS
  APROBADA
  RECHAZADA

  @@map("estado_solicitud")
}

enum MetodoSolicitud {
  RUC
  SIN_RUC_DNI
  SIN_RUC_RECOMENDACION
  SIN_RUC_CREDENCIAL

  @@map("metodo_solicitud")
}

/// Pedido de cuenta hecho por la propia tienda (RF-01, RF-04; sección 3 del lienzo «Versión final»).
/// Con RUC activo y habido en SUNAT se aprueba sola; sin RUC, una persona del equipo la revisa.
/// Los ids de quien revisó y de lo que se creó no llevan llave foránea: la solicitud es un
/// registro de lo que pasó y no debe impedir borrar una cuenta (auditoría guarda el resto).
model Solicitud {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Quien se registra consulta su estado con un código que solo ella conoce: aquí va su sha256.
  consultaHash        String          @unique @map("consulta_hash") @db.Char(64)
  /// Los 9 dígitos. Es también el usuario con el que entrará.
  celular             String          @db.VarChar(9)
  celularVerificadoEn DateTime        @map("celular_verificado_en") @db.Timestamptz(6)
  metodo              MetodoSolicitud
  ruc                 String?         @db.VarChar(11)
  /// Lo que contestó SUNAT: razón social, estado, condición y domicilio fiscal.
  rucDatos            Json?           @map("ruc_datos")
  /// Solo lo ve el equipo y se borra al resolver la solicitud (minimizar datos, Ley 29733).
  dni                 String?         @db.VarChar(8)
  /// Texto libre: la tienda verificada que la conoce, tal como la escribió.
  recomiendaTienda    String?         @map("recomienda_tienda") @db.VarChar(120)
  nombreComercial     String          @map("nombre_comercial") @db.VarChar(120)
  categorias          String[]
  galeriaId           String?         @map("galeria_id") @db.Uuid
  /// Si la galería no está registrada todavía: el nombre que escribió.
  galeriaOtra         String?         @map("galeria_otra") @db.VarChar(120)
  piso                String?         @db.VarChar(20)
  stand               String          @db.VarChar(20)
  referencia          String?         @db.VarChar(200)
  /// Ya armado para mostrar: «Lun a sáb, de 10:00 a. m. a 8:00 p. m.».
  horario             String          @db.VarChar(120)
  /// Lo mismo por partes (días, apertura y cierre), para volver a llenar el formulario al corregir.
  horarioDatos        Json            @map("horario_datos")
  encargado           String          @db.VarChar(120)
  claveHash           String          @map("clave_hash") @db.VarChar(255)
  aceptoTerminosEn    DateTime        @map("acepto_terminos_en") @db.Timestamptz(6)
  estado              EstadoSolicitud @default(PENDIENTE)
  /// Se aprobó sola por el RUC: queda a la vista del equipo por si el RUC era de otra persona.
  aprobadaSola        Boolean         @default(false) @map("aprobada_sola")
  /// Lo que el equipo le dice: qué corregir, o por qué no.
  mensajeEquipo       String?         @map("mensaje_equipo") @db.VarChar(500)
  venceEn             DateTime?       @map("vence_en") @db.Timestamptz(6)
  revisadaPorId       String?         @map("revisada_por_id") @db.Uuid
  revisadaEn          DateTime?       @map("revisada_en") @db.Timestamptz(6)
  tiendaId            String?         @unique @map("tienda_id") @db.Uuid
  usuarioId           String?         @unique @map("usuario_id") @db.Uuid
  creadaEn            DateTime        @default(now()) @map("creada_en") @db.Timestamptz(6)
  actualizadaEn       DateTime        @default(now()) @updatedAt @map("actualizada_en") @db.Timestamptz(6)

  @@index([estado, creadaEn])
  @@index([celular])
  @@map("solicitud")
}

/// El código de 6 dígitos que llega por SMS al celular de quien se registra. Verificado el
/// código, se entrega un token de un solo uso (su hash va aquí) para enviar la solicitud.
model CodigoCelular {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  celular       String    @db.VarChar(9)
  codigoHash    String    @map("codigo_hash") @db.Char(64)
  expiraEn      DateTime  @map("expira_en") @db.Timestamptz(6)
  intentos      Int       @default(0) @db.SmallInt
  verificadoEn  DateTime? @map("verificado_en") @db.Timestamptz(6)
  tokenHash     String?   @unique @map("token_hash") @db.Char(64)
  tokenExpiraEn DateTime? @map("token_expira_en") @db.Timestamptz(6)
  consumidoEn   DateTime? @map("consumido_en") @db.Timestamptz(6)
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([celular, creadoEn])
  @@map("codigo_celular")
}

/// «Avísame cuando alguien la publique» (EV_WebRes): cuando una tienda publica algo que tiene
/// todas las palabras, llega un aviso. Una por persona y búsqueda.
model AlertaBusqueda {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  /// Como lo escribió: «RTX 5090».
  texto     String    @db.VarChar(120)
  /// Las palabras normalizadas, separadas por un espacio: «rtx 5090».
  palabras  String    @db.VarChar(120)
  avisadaEn DateTime? @map("avisada_en") @db.Timestamptz(6)
  creadaEn  DateTime  @default(now()) @map("creada_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, palabras])
  @@map("alerta_busqueda")
}

/// El estado que elige quien publica (PUB_WebProducto).
enum EstadoDetalle {
  SELLADO
  OPEN_BOX
  USADO
  REACONDICIONADO
  /// «Otro» (COR9): el texto va en `estado_otro`.
  OTRO

  @@map("estado_detalle")
}

enum Garantia {
  SIN
  UN_MES
  TRES_MESES
  SEIS_MESES
  UN_ANIO
  FABRICA
  /// «Otro» (COR9): el texto va en `garantia_otra`.
  OTRA

  @@map("garantia")
}

/// «¿Cómo lo vendes?» (PS_Precio).
enum ModoVenta {
  PASE
  FACTURADO
  AMBOS

  @@map("modo_venta")
}

/// «Tus socios» (PS_SociosWeb): las tiendas a las que una tienda les deja ver su precio socio
/// y sus precios «Solo mis socios». Va en un sentido: que A tenga a B no hace que B tenga a A.
model Socio {
  tiendaId String   @map("tienda_id") @db.Uuid
  socioId  String   @map("socio_id") @db.Uuid
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  tienda Tienda @relation("SociosDe", fields: [tiendaId], references: [id], onDelete: Cascade)
  socio  Tienda @relation("SocioDe", fields: [socioId], references: [id], onDelete: Cascade)

  @@id([tiendaId, socioId])
  @@index([socioId])
  @@map("socio")
}

/// «48 vistas esta semana» (MP_Web): una fila por oferta, tienda que la vio en la ficha y día
/// (hora de Lima). Las de la propia tienda no cuentan.
model VistaOferta {
  ofertaId String   @map("oferta_id") @db.Uuid
  tiendaId String   @map("tienda_id") @db.Uuid
  dia      DateTime @db.Date

  oferta Oferta @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@id([ofertaId, tiendaId, dia])
  @@index([ofertaId, dia])
  @@map("vista_oferta")
}

/// El precio de pase de cada producto por día (CAT_Web4: «30 días» y «Cambio»): el más bajo y el
/// promedio de los que se muestran, en la moneda con más publicaciones. Se pone al día al abrir
/// la página de la categoría.
model PrecioDiario {
  productoId       String   @map("producto_id") @db.Uuid
  dia              DateTime @db.Date
  moneda           Moneda
  minimoCentimos   BigInt   @map("minimo_centimos")
  promedioCentimos BigInt   @map("promedio_centimos")
  ofertas          Int
  actualizadoEn    DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@id([productoId, dia])
  @@map("precio_diario")
}

/// El chat oficial con el equipo (REP_WebChatEquipo): uno por tienda, fijado arriba en Mensajes.
/// El equipo puede escribir primero (por un reporte, por ejemplo) y la tienda contesta.
model HiloEquipo {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tiendaId         String    @unique @map("tienda_id") @db.Uuid
  ultimoMensajeEn  DateTime  @default(now()) @map("ultimo_mensaje_en") @db.Timestamptz(6)
  /// Hasta dónde leyó la tienda y hasta dónde el equipo.
  leidoTiendaHasta DateTime? @map("leido_tienda_hasta") @db.Timestamptz(6)
  leidoEquipoHasta DateTime? @map("leido_equipo_hasta") @db.Timestamptz(6)
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  tienda   Tienda          @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  mensajes MensajeEquipo[]

  @@index([ultimoMensajeEn])
  @@map("hilo_equipo")
}

model MensajeEquipo {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hiloId     String   @map("hilo_id") @db.Uuid
  /// Nulo en la respuesta automática (N14).
  autorId    String?  @map("autor_id") @db.Uuid
  /// Lo escribió alguien del equipo (si no, alguien de la tienda).
  deEquipo   Boolean  @map("de_equipo")
  /// La respuesta automática: sale la primera vez o tras 12 h sin conversación (N14).
  automatica Boolean  @default(false)
  texto      String   @db.VarChar(2000)
  /// «Caso R-1031 · No cumplió con lo descrito»: el reporte del que se habla.
  denunciaId String?  @map("denuncia_id") @db.Uuid
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  hilo     HiloEquipo @relation(fields: [hiloId], references: [id], onDelete: Cascade)
  autor    Usuario?   @relation("MensajesEquipo", fields: [autorId], references: [id])
  denuncia Denuncia?  @relation(fields: [denunciaId], references: [id], onDelete: SetNull)

  @@index([hiloId, creadoEn])
  @@map("mensaje_equipo")
}

/// «Darle una advertencia» (REP_WebEquipo, ADM_WebTiendas): queda en el historial de la tienda.
/// Con 3, el equipo revisa la cuenta.
model Advertencia {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tiendaId   String   @map("tienda_id") @db.Uuid
  autorId    String   @map("autor_id") @db.Uuid
  motivo     String   @db.VarChar(200)
  denunciaId String?  @map("denuncia_id") @db.Uuid
  creadaEn   DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)

  tienda   Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  autor    Usuario   @relation("AdvertenciasDadas", fields: [autorId], references: [id])
  denuncia Denuncia? @relation(fields: [denunciaId], references: [id], onDelete: SetNull)

  @@index([tiendaId, creadaEn])
  @@map("advertencia")
}

/// Un mensaje del equipo para muchas tiendas a la vez (ADM_WebComunicados): llega a la campanita.
model Comunicado {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  autorId  String   @map("autor_id") @db.Uuid
  /// «Todas las tiendas» o el nombre de la galería.
  para     String   @db.VarChar(80)
  titulo   String   @db.VarChar(120)
  texto    String   @db.VarChar(600)
  /// A cuántas personas les llegó.
  enviados Int
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  autor Usuario @relation("ComunicadosEnviados", fields: [autorId], references: [id])

  @@index([creadoEn])
  @@map("comunicado")
}

/// «Lo último del equipo» (ADM_Web): quién hizo qué y cuándo en el panel.
model RegistroEquipo {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  autorId  String   @map("autor_id") @db.Uuid
  /// «aprobó a Tienda N (sin RUC) después de revisar su DNI».
  accion   String   @db.VarChar(240)
  /// La tienda de la que se trata: sale en «Historial de cambios» de su ficha (N14).
  tiendaId String?  @map("tienda_id") @db.Uuid
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  autor  Usuario @relation("RegistrosEquipo", fields: [autorId], references: [id])
  tienda Tienda? @relation(fields: [tiendaId], references: [id], onDelete: SetNull)

  @@index([creadoEn])
  @@index([tiendaId, creadoEn])
  @@map("registro_equipo")
}

/// «Destacar en silencio» (COR16): las publicaciones de una tienda salen más arriba un rato
/// (mezcladas entre los 4 primeros del inicio y más arriba en su categoría). Nadie más lo nota:
/// las otras tiendas no ven ninguna etiqueta. Hasta 3 tiendas a la vez; se apaga solo.
model Destacado {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tiendaId  String    @map("tienda_id") @db.Uuid
  porId     String    @map("por_id") @db.Uuid
  /// Las elegidas (hasta 3). Vacío: todas sus publicaciones.
  ofertas   String[]  @db.Uuid
  desde     DateTime  @default(now()) @db.Timestamptz(6)
  hasta     DateTime  @db.Timestamptz(6)
  /// Se le mandó «Te dimos un empujoncito 🤫».
  avisada   Boolean   @default(false)
  quitadoEn DateTime? @map("quitado_en") @db.Timestamptz(6)

  tienda Tienda  @relation(fields: [tiendaId], references: [id])
  por    Usuario @relation("DestacadosPor", fields: [porId], references: [id])

  @@index([hasta])
  @@index([tiendaId])
  @@map("destacado")
}

/// Un archivo para el catálogo (COR15): se lee y se revisa antes de guardar; nada se crea hasta
/// que el equipo lo confirma.
model ImportacionCatalogo {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  nombre     String    @db.VarChar(200)
  /// Las filas leídas, ya limpias, con lo que les falta.
  filas      Json
  /// Las fotos de la carpeta `fotos/` del .zip, por código de parte → ruta en /media.
  fotos      Json      @default("{}")
  creadaEn   DateTime  @default(now()) @map("creada_en") @db.Timestamptz(6)
  aplicadaEn DateTime? @map("aplicada_en") @db.Timestamptz(6)
  creados    Int       @default(0)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("importacion_catalogo")
}

enum EstadoCambioLugar {
  PENDIENTE
  APROBADO
  RECHAZADO
  /// La tienda lo cambió por otro o volvió a su lugar de antes.
  RETIRADO

  @@map("estado_cambio_lugar")
}

/// Galería, piso y stand nuevos de una tienda (N09_ConfigWebTodo). No cambian al guardar: quedan
/// «Pendiente de aprobación» hasta que el Equipo los confirma (o no). Una pendiente por tienda.
/// Quién lo pidió y quién lo revisó van sin llave foránea, como en `Solicitud`.
model CambioLugar {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tiendaId      String            @map("tienda_id") @db.Uuid
  galeriaId     String            @map("galeria_id") @db.Uuid
  piso          String?           @db.VarChar(20)
  stand         String            @db.VarChar(20)
  estado        EstadoCambioLugar @default(PENDIENTE)
  pedidoPorId   String            @map("pedido_por_id") @db.Uuid
  /// Lo que el Equipo le dice al rechazar.
  motivo        String?           @db.VarChar(300)
  revisadoPorId String?           @map("revisado_por_id") @db.Uuid
  revisadoEn    DateTime?         @map("revisado_en") @db.Timestamptz(6)
  creadoEn      DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)

  tienda  Tienda  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  galeria Galeria @relation(fields: [galeriaId], references: [id])

  @@index([estado, creadoEn])
  @@index([tiendaId])
  @@map("cambio_lugar")
}

/// «Ayudar como la tienda» (N14): alguien del equipo ve PaseLibre como el dueño durante 1 hora
/// para acomodar algo (portada, datos). Lo pide la tienda («Pedir ayuda al Equipo») o lo activa el
/// equipo; en los dos casos la tienda recibe aviso. No se puede chatear ni cerrar ventas.
model ModoSoporte {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tiendaId    String    @map("tienda_id") @db.Uuid
  /// Quien de la tienda lo pidió (nulo si lo activó el equipo).
  pedidoPorId String?   @map("pedido_por_id") @db.Uuid
  pedidoEn    DateTime? @map("pedido_en") @db.Timestamptz(6)
  /// Quien del equipo entró.
  equipoId    String?   @map("equipo_id") @db.Uuid
  iniciadoEn  DateTime? @map("iniciado_en") @db.Timestamptz(6)
  venceEn     DateTime? @map("vence_en") @db.Timestamptz(6)
  terminadoEn DateTime? @map("terminado_en") @db.Timestamptz(6)
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  pedidoPor Usuario? @relation("SoportePedidoPor", fields: [pedidoPorId], references: [id], onDelete: SetNull)
  equipo    Usuario? @relation("SoporteDelEquipo", fields: [equipoId], references: [id], onDelete: SetNull)
  sesiones  Sesion[]

  @@index([tiendaId, creadoEn])
  @@map("modo_soporte")
}

/// Ajustes del panel del equipo que se editan desde ahí, como la respuesta automática del chat.
model AjusteEquipo {
  clave            String   @id @db.VarChar(60)
  valor            String   @db.VarChar(2000)
  actualizadoEn    DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  actualizadoPorId String?  @map("actualizado_por_id") @db.Uuid

  @@map("ajuste_equipo")
}

/// Resumen de las ofertas vigentes de cada producto (docs/16 §4.4): buscar sin texto o por
/// categoría ya no recorre todas las ofertas. Una fila por producto con al menos una oferta que ve
/// un visitante. Lo mantienen triggers de la base (migración `20261112150000_resumen_de_productos`):
/// la API solo lo lee. Los precios son solo los visibles, y el visitante nunca los pide.
model ProductoResumen {
  productoId    String   @id @map("producto_id") @db.Uuid
  categoriaId   String   @map("categoria_id") @db.Uuid
  marcaId       String?  @map("marca_id") @db.Uuid
  titulo        String   @db.VarChar(200)
  ofertas       Int
  stock         Int
  nuevas        Int
  usadas        Int
  /// Ofertas con stock.
  conStock      Int      @map("con_stock")
  /// Ofertas por galería: `{ "<galeria_id>": 2, "independientes": 1 }`.
  galerias      Json
  actualizadaEn DateTime @map("actualizada_en") @db.Timestamptz(6)
  /// El menor precio visible en cada moneda, en céntimos; `barata_*`, solo entre las que tienen stock.
  desdeUsd      BigInt?  @map("desde_usd")
  desdePen      BigInt?  @map("desde_pen")
  barataUsd     BigInt?  @map("barata_usd")
  barataPen     BigInt?  @map("barata_pen")
  /// Ofertas sin precio visible.
  alInterno     Int      @map("al_interno")

  @@index([actualizadaEn(sort: Desc), titulo])
  @@index([categoriaId, actualizadaEn(sort: Desc), titulo])
  @@map("producto_resumen")
}
