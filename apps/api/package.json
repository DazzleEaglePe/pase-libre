{
  "name": "@paselibre/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:validate": "prisma validate",
    "cuenta:equipo": "tsx --env-file-if-exists=../../.env scripts/crear-cuenta-equipo.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/throttler": "6.5.0",
    "@paselibre/contracts": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@paselibre/config-eslint": "workspace:*",
    "@paselibre/config-typescript": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "@types/node": "22.20.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
